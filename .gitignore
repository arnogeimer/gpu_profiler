# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.python-version

# Docker (local-only deployment files, not part of the code)
Dockerfile
.dockerignore

# Generated outputs
results/
# Paper exports: ~170 MB reproduced from the hub by export_paper_data.py, so the script is the
# artefact worth versioning, not its output.
*_paper/
**/NVIDIA_*_metrics.csv
**/NVIDIA_*_smi.csv
**/NVIDIA_*_smi/

# Local notes / scratch
gpus.txt

# Local analysis / plots (not part of the deployed code)
plotting/
predictor/

# Local profiling tools. Run by hand against the workloads; main.py never imports them, so
# they only bloat the image the Dockerfile clones.
profiler/kernel_census.py
profiler/kernel_normalize.py
profiler/model_profiler.py
build_ground_truth.py

# Frozen health references, built locally by build_ground_truth.py from a results/ snapshot and
# uploaded to the dataset repo. Nodes fetch the one file for their own GPU model from HuggingFace
# at runtime, so shipping all 23 (2.0 MB) inside the image the Dockerfile clones is dead weight.
# The uploaded copies are the authority; these are the local staging area.
reference/
